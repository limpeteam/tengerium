package com.limpe.tengerium.data.protocol

import android.util.Base64
import android.util.Log
import com.limpe.tengerium.data.AppConfig
import kotlinx.coroutines.*
import kotlinx.coroutines.channels.Channel
import java.net.URLDecoder
import java.util.Locale
import java.util.concurrent.atomic.AtomicInteger

/**
 * High-level manager for the Notification Server (NS) connection, implementing MSNP9.
 * Updated based on project documentation for MSN 7.5 compatibility.
 */
class MSNPNSManager(private val listener: MSNPProtocolListener) : MSNPProtocolListener by listener {
    private var client: MSNPClient = MSNPClient(this)
    private val transactionId = AtomicInteger(1)
    private var myAccount: String = ""
    private var myPassword: String = ""
    private val soapManager = MSNPSoapManager()

    private val PRODUCT_ID = "PROD0101{0C7%3143"
    private val PRODUCT_KEY = "0S@7-S0WFR9W498U"

    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
    private var heartbeatJob: Job? = null

    private var lstCount = 0
    private var isSyncing = false
    private var currentHeartbeatInterval: Long = 60000L

    private var currentStatus: String = MSNPProto.Status.ONLINE

    private var lastHost: String = ""
    private var lastPort: Int = 1863
    private var isTransitioning = false

    private val commandQueue = Channel<MSNPCommand>(Channel.UNLIMITED)
    private val responseSignals = mutableMapOf<Int, CompletableDeferred<MSNPCommand>>()
    private val MIN_COMMAND_INTERVAL = 250L

    /**
     * MSNP Capability Flags (ClientID) as defined in docs/docs/files/client_capabilities.md
     */
    object Capabilities {
        // MSNC5 (0x50000000) for MSN 7.5+
        // INK (0x08) + WEBCAM (0x10) + MULTI_PACKET (0x20) + WINKS_NUDGE (0x8000) + VOICE_CLIPS (0x40000)
        // 0x50000000 + 0x48038 = 0x50048038 (1342472248)
        const val DEFAULT_MASK = 1342472248
    }

    init {
        startCommandProcessor()
    }

    private fun startCommandProcessor() {
        scope.launch {
            for (cmd in commandQueue) {
                while (isTransitioning) {
                    delay(500)
                }

                val tid = cmd.transactionId
                val deferred = if (tid != null) {
                    CompletableDeferred<MSNPCommand>().also {
                        synchronized(responseSignals) {
                            responseSignals[tid] = it
                        }
                    }
                } else null

                if (AppConfig.ENABLE_VERBOSE_LOGGING) {
                    Log.d("MSNP9", "Sending command: ${cmd.command} (TID: $tid)")
                }

                try {
                    client.sendCommand(cmd)
                } catch (e: Exception) {
                    Log.e("MSNP9", "Failed to send command ${cmd.command}: ${e.message}")
                    if (e is java.net.SocketException || e is java.io.IOException) {
                        Log.w("MSNP9", "Socket error detected during send. Reconnection might be needed.")
                        delay(1000)
                    }
                }

                if (deferred != null) {
                    try {
                        withTimeout(15000) {
                            deferred.await()
                        }
                    } catch (e: Exception) {
                        Log.w("MSNP9", "Timeout or interrupted waiting for response to ${cmd.command} ($tid)")
                    } finally {
                        synchronized(responseSignals) {
                            responseSignals.remove(tid)
                        }
                    }
                }

                delay(MIN_COMMAND_INTERVAL)
            }
        }
    }

    fun isConnected(): Boolean = true

    fun connect(host: String, port: Int, account: String, password: String) {
        lastHost = host
        lastPort = port
        myAccount = account.lowercase(Locale.ROOT)
        myPassword = password
        Log.i("MSNP9", "Connecting to $host:$port as $account")
        scope.launch {
            isTransitioning = false
            client.connect(host, port)
        }
    }

    override fun onConnected() {
        Log.i("MSNP9", "NS Connection established")
        isTransitioning = false
        send(MSNPProto.NS.VER, listOf(MSNPProto.VERSION, "MSNP8", MSNPProto.CVR_VERSION))
    }

    override fun onDisconnected() {
        Log.w("MSNP9", "NS Connection lost")
        heartbeatJob?.cancel()
        listener.onDisconnected()
    }

    override fun onCommandReceived(command: MSNPCommand) {
        if (AppConfig.ENABLE_VERBOSE_LOGGING) {
            Log.d("MSNP9", "Command received: ${command.command} (TID: ${command.transactionId})")
        }
        command.transactionId?.let { tid ->
            synchronized(responseSignals) {
                responseSignals[tid]?.complete(command)
            }
        }

        when (command.command) {
            MSNPProto.NS.VER -> {
                Log.d("MSNP9", "Handshaking: VER")
                // Using 7.5.0311 to match MSNC5 flag
                send(MSNPProto.NS.CVR, listOf("0x0409", "winnt", "5.1", "i386", "MSNMSGR", "7.5.0311", "MSMSGS", myAccount))
            }
            MSNPProto.NS.CVR -> {
                Log.d("MSNP9", "Handshaking: CVR")
                send(MSNPProto.NS.USR, listOf("TWN", "I", myAccount))
            }
            MSNPProto.NS.XFR -> {
                val type = command.params.getOrNull(0)
                val address = command.params.getOrNull(1) ?: ""
                val parts = address.split(":")
                val host = parts[0]
                val port = parts.getOrNull(1)?.toIntOrNull() ?: MSNPProto.DEFAULT_PORT

                Log.i("MSNP9", "Received XFR request: type=$type, address=$address")

                if (type == "NS") {
                    scope.launch {
                        Log.i("MSNP9", "Redirecting to another NS: $address")
                        isTransitioning = true
                        client.disconnect()
                        synchronized(responseSignals) {
                            responseSignals.values.forEach { it.cancel() }
                            responseSignals.clear()
                        }
                        client = MSNPClient(this@MSNPNSManager)
                        client.connect(host, port)
                    }
                } else if (type == "SB") {
                    val key = command.params.getOrNull(3) ?: ""
                    Log.i("MSNP9", "Switchboard redirection received. TID=${command.transactionId}")
                    listener.onSwitchboardRequest(host, port, key, transactionId = command.transactionId)
                }
            }
            MSNPProto.NS.CHL -> {
                val challenge = command.params.getOrNull(0) ?: ""
                Log.d("MSNP9", "Solving challenge: $challenge")
                val response = MSNPChallenge.solveMSNP11(PRODUCT_ID, PRODUCT_KEY, challenge)
                send(MSNPProto.NS.QRY, listOf(PRODUCT_ID), response)
            }
            MSNPProto.NS.USR -> {
                if (command.params.getOrNull(0) == "TWN" && command.params.getOrNull(1) == "S") {
                    val challenge = command.params.getOrNull(2) ?: ""
                    Log.d("MSNP9", "Authentication required. Challenge: $challenge")
                    scope.launch {
                        try {
                            val token = soapManager.authenticate(myAccount, myPassword, challenge)
                            if (token != null) {
                                Log.d("MSNP9", "Authentication token obtained. Sending USR S with ClientID.")
                                // Critical: USR S must include ClientID for features to be enabled
                                send(MSNPProto.NS.USR, listOf("TWN", "S", token, Capabilities.DEFAULT_MASK.toString()))
                            } else {
                                Log.e("MSNP9", "Authentication failed (token is null)")
                                listener.onError("AUTH_FAILED")
                            }
                        } catch (e: Exception) {
                            Log.e("MSNP9", "Authentication error", e)
                            listener.onError("AUTH_ERROR")
                        }
                    }
                } else if (command.params.getOrNull(0) == "OK") {
                    val nick = if (command.params.size > 2) decodeNick(command.params[2]) else myAccount
                    Log.i("MSNP9", "Login successful for $myAccount (Nick: $nick)")
                    listener.onAuthSuccess(myAccount, nick)

                    send(MSNPProto.NS.PNG, emptyList())
                    startHeartbeat()

                    // Initial status with verified ClientID
                    changeStatus(currentStatus)

                    isSyncing = true
                    lstCount = 0
                    Log.d("MSNP9", "Starting contact list synchronization...")
                    send(MSNPProto.NS.SYN, listOf("0"))
                }
            }
            MSNPProto.NS.SYN -> {
                isSyncing = false
                Log.d("MSNP9", "Synchronization finished. Received $lstCount contacts.")
                scope.launch {
                    delay(500)
                    changeStatus(currentStatus)
                }
            }
            MSNPProto.NS.LST -> {
                lstCount++
                if (isSyncing && lstCount % 50 == 0) {
                    send(MSNPProto.NS.PNG, emptyList())
                }

                val account = command.params.getOrNull(0) ?: ""
                val nick = decodeNick(command.params.getOrNull(1) ?: "")
                val mask = command.params.getOrNull(2)?.toIntOrNull() ?: 0

                if ((mask and 1) != 0) listener.onContactAdded(account, nick, "FL")
                if ((mask and 2) != 0) listener.onContactAdded(account, nick, "AL")
                if ((mask and 4) != 0) listener.onContactAdded(account, nick, "BL")
                if ((mask and 8) != 0) listener.onContactAdded(account, nick, "RL")
            }
            MSNPProto.NS.RNG -> {
                val sessionId = command.params.getOrNull(0) ?: ""
                val address = command.params.getOrNull(1) ?: ""
                val parts = address.split(":")
                val host = parts[0]
                val port = parts.getOrNull(1)?.toIntOrNull() ?: MSNPProto.DEFAULT_PORT
                val key = command.params.getOrNull(3) ?: ""
                val callerAccount = command.params.getOrNull(4) ?: ""
                val callerNickname = decodeNick(command.params.getOrNull(5) ?: "")

                Log.d("MSNP9", "Incoming SB request from $callerAccount (Session: $sessionId)")
                listener.onSwitchboardRequest(host, port, key, sessionId, callerAccount, callerNickname)
            }
            MSNPProto.NS.ILN -> {
                val status = command.params.getOrNull(0) ?: ""
                val account = command.params.getOrNull(1) ?: ""
                val nick = decodeNick(command.params.getOrNull(2) ?: "")
                val msnObj = command.params.getOrNull(4)
                handleIncomingStatus(account, status, nick, msnObj)
            }
            MSNPProto.NS.NLN -> {
                val status = command.params.getOrNull(0) ?: ""
                val account = command.params.getOrNull(1) ?: ""
                val nick = decodeNick(command.params.getOrNull(2) ?: "")
                val msnObj = command.params.getOrNull(4)
                handleIncomingStatus(account, status, nick, msnObj)
            }
            MSNPProto.NS.FLN -> {
                val account = command.params.getOrNull(0) ?: ""
                listener.onContactStatusChanged(account, MSNPProto.Status.OFFLINE, "")
            }
            MSNPProto.NS.CHG -> {
                val status = command.params.getOrNull(0) ?: ""
                listener.onContactStatusChanged(myAccount, status, "")
            }
            MSNPProto.NS.MSG -> {
                val sender = command.params.getOrNull(0) ?: ""
                val payload = command.payloadString ?: ""
                if (payload.contains("Content-Type: text/x-msmsgsprofile")) {
                    val psm = parsePsm(payload)
                    if (psm != null) {
                        listener.onContactPersonalMessageChanged(sender, psm)
                    }
                }
            }
        }
        listener.onCommandReceived(command)
    }

    private fun handleIncomingStatus(account: String, status: String, nick: String, msnObj: String?) {
        listener.onContactStatusChanged(account, status, nick)
        if (!AppConfig.enableAvatars) return
        if (msnObj != null && msnObj != "%3Cmsnobj%2F%3E" && msnObj.isNotEmpty()) {
            try {
                val decoded = URLDecoder.decode(msnObj, "UTF-8")
                val sha1Base64 = parseSha1FromMsnObj(decoded)
                if (sha1Base64 != null) {
                    val sha1Hex = base64ToHex(sha1Base64)
                    if (sha1Hex != null) {
                        val avatarUrl = "https://storage.escargot.chat/avatar/${sha1Hex.lowercase(Locale.ROOT)}.png"
                        listener.onContactPersonalMessageChanged(account, "AVATAR_URL:$avatarUrl")
                    }
                }
            } catch (e: Exception) {
                Log.e("MSNP_PROTO", "Error parsing msnobj for $account", e)
            }
        }
    }

    private fun base64ToHex(base64: String): String? {
        return try {
            val bytes = Base64.decode(base64, Base64.DEFAULT)
            bytes.joinToString("") { "%02x".format(it) }
        } catch (e: Exception) {
            null
        }
    }

    private fun parseSha1FromMsnObj(xml: String): String? {
        val pattern = "SHA1D=\"([^\"]+)\"".toRegex()
        val match = pattern.find(xml)
        return match?.groupValues?.get(1)
    }

    private fun parsePsm(payload: String): String? {
        val lines = payload.split("\r\n")
        for (line in lines) {
            if (line.startsWith("PSM: ")) {
                return line.substring(5)
            }
        }
        return null
    }

    private fun decodeNick(nick: String): String {
        return try {
            URLDecoder.decode(nick, "UTF-8")
        } catch (e: Exception) {
            nick
        }
    }

    /**
     * Updates user status and capabilities.
     * Mask is strictly following the project documentation for MSN 7.5.
     */
    fun changeStatus(status: String) {
        this.currentStatus = status
        val maskStr = Capabilities.DEFAULT_MASK.toString()
        Log.d("MSNP9", "Changing status to $status with ClientID: $maskStr")

        val params = listOf(status, maskStr)
        send(MSNPProto.NS.CHG, params)
    }

    fun updateNickname(nick: String) {
        Log.d("MSNP9", "Updating nickname to $nick")
        send(MSNPProto.NS.PRP, listOf("MFN", nick))
    }

    fun updatePersonalMessage(psm: String) {
        Log.d("MSNP9", "Updating PSM: $psm")
        val payload = "MIME-Version: 1.0\r\nContent-Type: text/x-msmsgsprofile\r\n\r\nPSM: $psm\r\n"
        send(MSNPProto.NS.MSG, listOf("U"), payload)
    }

    fun addContact(account: String, listMask: Int = MSNPProto.List.FL or MSNPProto.List.AL) {
        if ((listMask and MSNPProto.List.FL) != 0) send(MSNPProto.NS.ADD, listOf("FL", account, account))
        if ((listMask and MSNPProto.List.AL) != 0) send(MSNPProto.NS.ADD, listOf("AL", account, account))
    }

    fun removeContact(account: String, listMask: Int = MSNPProto.List.FL) {
        if ((listMask and MSNPProto.List.FL) != 0) send(MSNPProto.NS.REM, listOf("FL", account))
    }

    fun requestSwitchboard(): Int {
        return send(MSNPProto.NS.XFR, listOf("SB")) ?: 0
    }

    private fun send(commandName: String, params: List<String>, payload: String? = null): Int? {
        val tid = if (commandName == MSNPProto.NS.PNG || commandName == MSNPProto.NS.OUT) null else transactionId.getAndIncrement()
        val command = MSNPCommand(commandName, tid, params, payload?.toByteArray(Charsets.UTF_8))
        scope.launch {
            try {
                commandQueue.send(command)
            } catch (e: Exception) {
                Log.e("MSNP9", "Failed to queue command $commandName: ${e.message}")
            }
        }
        return tid
    }

    private fun startHeartbeat() {
        heartbeatJob?.cancel()
        heartbeatJob = scope.launch {
            while (isActive) {
                delay(currentHeartbeatInterval)
                send(MSNPProto.NS.PNG, emptyList())
            }
        }
    }

    fun disconnect() {
        Log.i("MSNP9", "Disconnecting...")
        scope.launch {
            try {
                send(MSNPProto.NS.OUT, emptyList())
                delay(200)
            } catch (ignored: Exception) {}
            client.disconnect()
            heartbeatJob?.cancel()
        }
    }
}
