package com.limpe.tengerium.data.protocol

import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.security.MessageDigest

/**
 * Решаем задачки от сервера (CHL). Чистая математика, никакой магии xD
 */
object MSNPChallenge {

    private fun md5(input: ByteArray): ByteArray {
        val md = MessageDigest.getInstance("MD5")
        return md.digest(input)
    }

    private fun swapEndianness32(num: Long): Long {
        val b = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN).putLong(num).array()
        return ByteBuffer.wrap(byteArrayOf(b[3], b[2], b[1], b[0], 0, 0, 0, 0)).order(ByteOrder.LITTLE_ENDIAN).long
    }

    fun solveMSNP11(publicKey: String, privateKey: String, challenge: String): String {
        // Часть 1: Начальный MD5
        val initialConstant = md5((challenge + privateKey).toByteArray(Charsets.US_ASCII))
        val privateSeed = IntArray(4)
        val buf = ByteBuffer.wrap(initialConstant).order(ByteOrder.LITTLE_ENDIAN)
        for (i in 0 until 4) {
            privateSeed[i] = buf.int and 0x7FFFFFFF
        }

        // Часть 2: Публичный сид
        var publicString = challenge + publicKey
        val padLen = 8 - (publicString.length % 8)
        if (padLen != 8) {
            publicString = publicString.padEnd(publicString.length + padLen, '0')
        }
        val publicBytes = publicString.toByteArray(Charsets.US_ASCII)
        val publicSeed = IntArray(publicString.length / 4)
        val pubBuf = ByteBuffer.wrap(publicBytes).order(ByteOrder.LITTLE_ENDIAN)
        for (i in publicSeed.indices) {
            publicSeed[i] = pubBuf.int and 0x7FFFFFFF
        }

        // Часть 3: Генерация ключа
        var high = 0L
        var low = 0L
        for (i in publicSeed.indices step 2) {
            var temp = publicSeed[i].toLong()
            temp = ((temp * 0x0E79A9C1L) % 0x7FFFFFFFL) + high
            temp = ((temp * privateSeed[0]) + privateSeed[1]) % 0x7FFFFFFFL

            high = (publicSeed[i + 1] + temp) % 0x7FFFFFFFL
            high = ((high * privateSeed[2]) + privateSeed[3]) % 0x7FFFFFFFL

            low += high + temp
        }

        high = (high + privateSeed[1]) % 0x7FFFFFFFL
        low = (low + privateSeed[3]) % 0x7FFFFFFFL

        val swappedHigh = swapEndianness32(high)
        val swappedLow = swapEndianness32(low)

        val key = (swappedHigh shl 32) or (swappedLow and 0xFFFFFFFFL)

        // Часть 4: XOR с начальным MD5
        val initialLongs = ByteBuffer.wrap(initialConstant).order(ByteOrder.LITTLE_ENDIAN)
        val resLow = initialLongs.long xor key
        val resHigh = initialLongs.long xor key

        val result = ByteBuffer.allocate(16).order(ByteOrder.LITTLE_ENDIAN)
            .putLong(resLow)
            .putLong(resHigh)
            .array()

        return result.joinToString("") { "%02x".format(it) }
    }
}
