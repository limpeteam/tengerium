package com.limpe.tengerium.data.protocol

import android.util.Log
import kotlinx.coroutines.*
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import java.io.InputStream
import java.io.PrintWriter
import java.net.Socket
import java.security.MessageDigest
import java.util.Locale
import java.io.IOException
import java.io.ByteArrayOutputStream
import java.net.InetSocketAddress
import java.net.SocketTimeoutException

/**
 * Менеджер сессии MSNP4 с логикой переподключения и синхронизацией команд.
 */
class MSNPSessionManager(
    private val listener: MSNPProtocolListener
) {
    private var socket: Socket? = null
    private var inputStream: InputStream? = null
    private var outputStream: java.io.OutputStream? = null
    private var transactionId = 1

    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
    @Volatile
    private var isRunning = false
    private var myAccount: String = ""
    private var myPassword: String = ""
    private var lastHost: String = ""
    private var lastPort: Int = 1863

    private var heartbeatJob: Job? = null
    private var heartbeatInterval: Long = 15000L
    private val sendMutex = Mutex()

    private var retryCount = 0
    private val maxRetries = 5
    private var isReconnecting = false
    private var isTransitioning = false

    fun isConnected(): Boolean = isRunning && socket?.isConnected == true

    fun connect(host: String, port: Int, account: String, password: String, isRetry: Boolean = false) {
        if (!isRetry) {
            myAccount = account.lowercase(Locale.ROOT)
            myPassword = password
            lastHost = host
            lastPort = port
            retryCount = 0
            isReconnecting = false
        }
        isTransitioning = false

        scope.launch {
            internalConnect(host, port)
        }
    }

    private suspend fun internalConnect(host: String, port: Int) {
        stopSocketInternal()

        try {
            Log.d("MSNP", "Connecting to $host:$port...")
            val newSocket = Socket()
            newSocket.connect(InetSocketAddress(host, port), 20000)
            // Сократили таймаут до 60 секунд. 120 было слишком много.
            newSocket.soTimeout = 60000
            newSocket.keepAlive = true

            socket = newSocket
            outputStream = newSocket.getOutputStream()
            inputStream = newSocket.getInputStream()

            isRunning = true
            isReconnecting = false
            retryCount = 0
            transactionId = 1

            listener.onConnected()

            sendCommand("VER", "MSNP4 CVR0")
            readLoop()
        } catch (e: Exception) {
            Log.e("MSNP", "Connection failed to $host:$port: ${e.message}")
            if (!isTransitioning) handleConnectionFailure()
        }
    }

    private fun handleConnectionFailure() {
        if (isReconnecting || isTransitioning || retryCount >= maxRetries) {
            if (retryCount >= maxRetries && isRunning) {
                isRunning = false
                isReconnecting = false
                listener.onError("RECONNECT_FAILED")
                listener.onDisconnected()
            }
            return
        }

        retryCount++
        isReconnecting = true
        isRunning = false

        scope.launch {
            val backoff = (retryCount * 3000L).coerceAtMost(30000L)
            listener.onRawLog("MSNP_DEBUG", "Connection lost. Retrying ($retryCount/$maxRetries) in ${backoff/1000}s...")
            stopSocketInternal()
            delay(backoff)
            if (isReconnecting) {
                internalConnect(lastHost, lastPort)
            }
        }
    }

    private suspend fun readLoop() {
        try {
            while (isRunning) {
                val line = try {
                    withContext(Dispatchers.IO) { readLineInternal() }
                } catch (e: SocketTimeoutException) {
                    // Игнорируем таймаут чтения. Если соединение реально мертво,
                    // это обнаружится при следующей попытке отправки данных или через keep-alive.
                    if (isRunning) continue else break
                } ?: break

                if (line.isEmpty()) continue

                listener.onRawLog("MSNP_IN", line)
                val cmd = try { MSNPCommand.parse(line) } catch (e: Exception) {
                    Log.e("MSNP", "Command parse failed: $line")
                    null
                } ?: continue

                if (cmd.command == "MSG" || cmd.command == "IPG" || cmd.command == "NOT") {
                    val length = cmd.params.lastOrNull()?.toIntOrNull() ?: 0
                    if (length > 0) {
                        val body = withContext(Dispatchers.IO) { readBytesInternal(length) }
                        try {
                            listener.onRawLog("MSNP_BODY", String(body, Charsets.UTF_8))
                        } catch (e: Exception) {
                            listener.onRawLog("MSNP_BODY", "[Binary data: ${body.size} bytes]")
                        }
                    }
                }

                handleCommand(cmd)
            }
        } catch (e: Exception) {
            if (isRunning && !isTransitioning) {
                Log.e("MSNP", "Read loop error: ${e.message}")
                handleConnectionFailure()
            }
        } finally {
            if (!isReconnecting && !isTransitioning) {
                stopSocketInternal()
                listener.onDisconnected()
            }
        }
    }

    private fun readLineInternal(): String? {
        val bos = ByteArrayOutputStream()
        while (true) {
            val b = try { inputStream?.read() ?: -1 } catch (e: Exception) { throw e }
            if (b == -1) return if (bos.size() > 0) bos.toString("UTF-8") else null
            if (b == '\n'.code) break
            if (b != '\r'.code) bos.write(b)
        }
        return bos.toString("UTF-8")
    }

    private fun readBytesInternal(length: Int): ByteArray {
        val buffer = ByteArray(length)
        var totalRead = 0
        while (totalRead < length) {
            val read = try { inputStream?.read(buffer, totalRead, length - totalRead) ?: -1 } catch (e: Exception) { throw e }
            if (read == -1) break
            totalRead += read
        }
        return buffer
    }

    private fun handleCommand(cmd: MSNPCommand) {
        if (cmd.command.length == 3 && cmd.command.all { it.isDigit() }) {
            handleErrorCode(cmd)
            return
        }

        when (cmd.command) {
            "VER" -> sendCommand("INF", null)
            "INF" -> {
                if (cmd.params.contains("MD5")) {
                    sendCommand("CVR", "0x0409 winnt 5.1 i386 MSMSGS 8.1.0178 MSMSGS $myAccount")
                    sendCommand("USR", "MD5 I $myAccount")
                } else {
                    listener.onError("Server doesn't support MD5 authentication.")
                }
            }
            "XFR" -> {
                val addressWithPort = cmd.params[1]
                val parts = addressWithPort.split(":")
                val host = parts[0]
                val port = if (parts.size > 1) parts[1].toInt() else 1863

                if (cmd.params[0] == "NS") {
                    isTransitioning = true
                    scope.launch {
                        internalConnect(host, port)
                    }
                } else if (cmd.params[0] == "SB") {
                    val key = if (cmd.params.size >= 4) cmd.params[3] else if (cmd.params.size >= 3) cmd.params[2] else ""
                    listener.onSwitchboardRequest(host, port, key, transactionId = cmd.transactionId)
                }
            }
            "USR" -> {
                if (cmd.params.size >= 3 && cmd.params[1] == "S") {
                    val challenge = cmd.params[2]
                    val hash = computeMd5(challenge + myPassword)
                    sendCommand("USR", "MD5 S $hash")
                } else if (cmd.params.isNotEmpty() && cmd.params[0] == "OK") {
                    val displayAccount = if (cmd.params.size > 1) cmd.params[1] else myAccount
                    val displayName = if (cmd.params.size > 2) cmd.params[2] else displayAccount
                    listener.onAuthSuccess(displayAccount, displayName)
                    startHeartbeat()
                    sendCommand("SYN", "0")
                }
            }
            "SYN" -> {
                listener.onRawLog("MSNP_DEBUG", "Synchronization started (SYN)")
                scope.launch {
                    delay(500)
                    changeStatus("NLN")
                }
            }
            "ADD" -> {
                if (cmd.params.size >= 4 && cmd.params[0] == "RL") {
                    val account = cmd.params[3]
                    val nickname = if (cmd.params.size > 4) cmd.params[4] else account
                    listener.onContactAdded(account, nickname, "RL")
                } else {
                    dispatchToListener(cmd)
                }
            }
            "LST" -> {
                dispatchToListener(cmd)
            }
            "RNG" -> {
                val sessionId = cmd.params[0]
                val addressWithPort = cmd.params[1]
                val key = if (cmd.params.size > 3) cmd.params[3] else cmd.params[2]
                val callerAccount = if (cmd.params.size > 4) cmd.params[4] else null
                val callerNickname = if (cmd.params.size > 5) cmd.params[5] else null
                val parts = addressWithPort.split(":")
                val host = parts[0]
                val port = if (parts.size > 1) parts[1].toInt() else 1863
                listener.onSwitchboardRequest(host, port, key, sessionId, callerAccount, callerNickname)
            }
            "PNG", "QNG" -> {
                if (cmd.command == "QNG") {
                    val nextSeconds = cmd.params.firstOrNull()?.toLongOrNull()
                    if (nextSeconds != null && nextSeconds > 0) {
                        heartbeatInterval = (nextSeconds * 1000L).coerceAtLeast(10000L)
                        listener.onRawLog("MSNP_DEBUG", "Server set ping interval to ${nextSeconds}s")
                        startHeartbeat()
                    } else {
                        listener.onRawLog("MSNP_DEBUG", "Server acknowledged ping (QNG)")
                    }
                } else if (cmd.command == "PNG") {
                    // Если сервер прислал PNG, отвечаем QNG
                    sendCommand("QNG", null)
                }
            }
            "OUT" -> {
                isRunning = false
                listener.onDisconnected()
            }
            else -> dispatchToListener(cmd)
        }
    }

    private fun dispatchToListener(cmd: MSNPCommand) {
        when(cmd.command) {
            "GTC" -> if (cmd.params.size >= 2) listener.onPrivacySettingChanged("GTC", cmd.params[1])
            "BLP" -> if (cmd.params.size >= 2) listener.onPrivacySettingChanged("BLP", cmd.params[1])
            "LST" -> if (cmd.params.size >= 2) {
                val accountIdx = if (cmd.params.size >= 5) 4 else 1
                val nickIdx = accountIdx + 1
                val nickname = if (cmd.params.size > nickIdx) cmd.params[nickIdx] else cmd.params[accountIdx]
                listener.onContactAdded(cmd.params[accountIdx], nickname, cmd.params[0])
            }
            "ADD" -> if (cmd.params.size >= 2) {
                val accountIdx = if (cmd.params.size >= 5) 4 else if (cmd.params.size > 2) 2 else 1
                val nickIdx = accountIdx + 1
                val nickname = if (cmd.params.size > nickIdx) cmd.params[nickIdx] else cmd.params[accountIdx]
                listener.onContactAdded(cmd.params[accountIdx], nickname, cmd.params[0])
            }
            "REM" -> if (cmd.params.size >= 2) {
                val accountIdx = if (cmd.params.size > 2 && cmd.params[1].all { it.isDigit() }) 2 else 1
                listener.onContactRemoved(cmd.params[accountIdx], cmd.params[0])
            }
            "REA" -> if (cmd.params.isNotEmpty()) {
                val account = cmd.params[0]
                val nickname = if (cmd.params.size > 1) cmd.params[1] else ""
                listener.onContactRenamed(account, nickname)
            }
            "ILN", "NLN" -> if (cmd.params.size >= 2) {
                val status = cmd.params[0]
                val account = cmd.params[1]
                val nickname = if (cmd.params.size > 2) cmd.params[2] else ""
                listener.onContactStatusChanged(account, status, nickname)
            }
            "FLN" -> if (cmd.params.isNotEmpty()) {
                listener.onContactStatusChanged(cmd.params[0], "FLN", "")
            }
            "CHG" -> if (cmd.params.isNotEmpty()) {
                listener.onContactStatusChanged(myAccount, cmd.params[0], "")
            }
        }
    }

    private fun handleErrorCode(cmd: MSNPCommand) {
        val criticalCodes = listOf("911", "711", "217", "540", "601", "302")
        if (criticalCodes.contains(cmd.command)) {
            isRunning = false
            listener.onError("CRITICAL_ERROR_${cmd.command}")
            disconnect()
        }
    }

    private fun startHeartbeat() {
        heartbeatJob?.cancel()
        heartbeatJob = scope.launch {
            listener.onRawLog("MSNP_DEBUG", "Starting heartbeat loop ($heartbeatInterval ms)")
            while (isRunning) {
                delay(heartbeatInterval)
                if (isRunning) sendCommand("PNG", null)
            }
        }
    }

    fun changeStatus(status: String) {
        // Устанавливаем флаги способностей клиента (Capabilities).
        // 0x10000000 (268435456) - Базовый флаг MSNC1 (Client v6.0+)
        // 0x00000008 (8) - Поддержка Ink (рукописный ввод)
        // 0x00000004 (4) - Поддержка GIF
        // 0x00008000 (32768) - Поддержка Winks
        // 0x00040000 (262144) - Поддержка Voice Clips
        // 0x00000010 (16) - Наличие веб-камеры
        // Сумма всех основных флагов для максимальной совместимости: 268730260
        sendCommand("CHG", "$status 268730260")
    }

    fun addContact(listType: String, account: String) = sendCommand("ADD", "$listType $account $account")
    fun removeContact(listType: String, account: String) = sendCommand("REM", "$listType $account")
    fun renameContact(account: String, newNickname: String) = sendCommand("REA", "$account $newNickname")
    fun requestSwitchboard(): Int {
        if (!isConnected()) return -1
        return sendCommand("XFR", "SB")
    }

    fun sendCommand(cmd: String, params: String?, includeTid: Boolean = true): Int {
        val cleanCmd = cmd.trim().uppercase(Locale.ROOT)

        // PNG, QNG и OUT никогда не должны иметь Transaction ID в MSNP4
        val shouldExcludeTid = when (cleanCmd) {
            "PNG", "QNG", "OUT" -> true
            else -> !includeTid
        }

        val id = if (!shouldExcludeTid) transactionId++ else -1

        val line = StringBuilder(cleanCmd)
        if (!shouldExcludeTid) {
            line.append(" ").append(id)
        }
        if (params != null) {
            line.append(" ").append(params)
        }
        val finalLine = line.toString()

        scope.launch {
            sendMutex.withLock {
                withContext(Dispatchers.IO) {
                    try {
                        val out = outputStream
                        if (out != null && isRunning) {
                            out.write("$finalLine\r\n".toByteArray(Charsets.UTF_8))
                            out.flush()
                            listener.onRawLog("MSNP_OUT", finalLine)
                        } else {
                            throw IOException("Not connected")
                        }
                    } catch (e: Exception) {
                        Log.e("MSNP", "Send failed: $finalLine, error: ${e.message}")
                        if (isRunning && !isTransitioning) handleConnectionFailure()
                    }
                }
            }
        }
        return id
    }

    private fun computeMd5(input: String): String {
        val md = MessageDigest.getInstance("MD5")
        return md.digest(input.toByteArray()).joinToString("") { "%02x".format(it) }
    }

    private fun stopSocketInternal() {
        isRunning = false
        heartbeatJob?.cancel()
        try {
            socket?.close()
            inputStream?.close()
            outputStream?.close()
        } catch (ignored: Exception) {}
        socket = null
        inputStream = null
        outputStream = null
    }

    fun disconnect() {
        if (!isRunning && !isReconnecting) return
        isRunning = false
        isReconnecting = false
        scope.launch(Dispatchers.IO) {
            try {
                sendCommand("OUT", null)
                delay(100)
            } catch (ignored: Exception) {}
            stopSocketInternal()
            listener.onDisconnected()
        }
    }
}
