<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_default_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <View
        android:id="@+id/viewStatusBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_status_border"
        app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/ivAvatar"
        app:layout_constraintHeight_percent="0.35" />

    <View
        android:id="@+id/viewStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/status_dot"
        app:layout_constraintBottom_toBottomOf="@id/viewStatusBorder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/viewStatusBorder"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="@id/viewStatusBorder"
        app:layout_constraintTop_toTopOf="@id/viewStatusBorder" />

</merge>
