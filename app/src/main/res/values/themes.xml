<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Tengerium" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>

        <!-- Material 3 specific -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Material3.LabelSmall</item>

        <!-- Customizing Dialog Shape -->
        <item name="alertDialogTheme">@style/Theme.Tengerium.AlertDialog</item>
    </style>

    <style name="Theme.Tengerium" parent="Base.Theme.Tengerium" />

    <style name="Theme.Tengerium.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Tengerium.Dialog</item>
    </style>

    <style name="ShapeAppearance.Tengerium.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Material Design Button Style -->
    <style name="Widget.Tengerium.Button" parent="Widget.Material3.Button" />

    <!-- Updated styles to be Pure Material 3 -->
    <style name="Widget.Tengerium.Button.Glass" parent="Widget.Material3.Button.TonalButton" />

    <style name="Widget.Tengerium.Card.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Theme.Tengerium.GlassBottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog" />

    <style name="Theme.Tengerium.ModalProfile" parent="Theme.Material3.DayNight.Dialog">
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Tengerium.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
